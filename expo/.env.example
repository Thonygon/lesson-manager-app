# Browser-safe Supabase configuration only.
# Find these values in Supabase Dashboard > Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
# Hosted Expo API origin for native builds; point preview builds at their own environment.
EXPO_PUBLIC_HOSTING_URL=https://classio.expo.app

# Server-only Google Calendar OAuth credentials for the calendar API routes.
# Add these to the EAS Hosting environment; never prefix them with EXPO_PUBLIC_.
# In Google Cloud, authorize https://classio.expo.app/api/google-calendar-callback as a redirect URI.
GOOGLE_CAL_CLIENT_ID=your-calendar-oauth-client-id.apps.googleusercontent.com
GOOGLE_CAL_CLIENT_SECRET=your-calendar-oauth-client-secret
GOOGLE_CAL_STATE_SECRET=a-long-random-secret-for-signing-oauth-state
GOOGLE_CAL_REDIRECT_URI=https://classio.expo.app/api/google-calendar-callback

# Optional protected Python API used while server-only capabilities migrate.
# This URL is public; credentials are supplied by the signed-in Supabase session.
EXPO_PUBLIC_CLASSIO_API_URL=https://classio-python-api.onrender.com
