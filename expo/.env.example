# Browser-safe Supabase configuration only.
# Find these values in Supabase Dashboard > Project Settings > API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# Optional protected Python API used while server-only capabilities migrate.
# This URL is public; credentials are supplied by the signed-in Supabase session.
EXPO_PUBLIC_CLASSIO_API_URL=https://api.example.com
